{
  "name": "roleta-native",
  "version": "3.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:apk": "npx eas-cli@25.2.0 build --platform android --profile preview",
    "build:production": "npx eas-cli@25.2.0 build --platform android --profile production",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "preview:web": "node scripts/serve-web.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e scripts App.tsx index.ts",
    "build:apk:local": "node scripts/build-local-apk.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-blur": "~55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-haptics": "~55.0.18",
    "expo-linear-gradient": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
